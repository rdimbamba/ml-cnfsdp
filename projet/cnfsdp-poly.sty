\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage{booktabs,array}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{csquotes}
\RequirePackage{xurl}
\RequirePackage[hidelinks]{hyperref}

\setlist{itemsep=0.25em,topsep=0.4em}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}

% ---------------------------------------------------------------------
%  Couleurs (identiques au thème beamer)
% ---------------------------------------------------------------------
\definecolor{cnfVert}{HTML}{126B2A}
\definecolor{cnfVertVif}{HTML}{00A04A}
\definecolor{cnfJaune}{HTML}{F2E600}
\definecolor{cnfRouge}{HTML}{D7191F}
\definecolor{cnfTexte}{HTML}{1E1E1E}
\definecolor{cnfGris}{HTML}{6B6B6B}
\definecolor{cnfGrisClair}{HTML}{F3F4F2}
\definecolor{cnfVertPale}{HTML}{EEF6F0}
\definecolor{cnfJaunePale}{HTML}{FFFBE0}
\definecolor{cnfRougePale}{HTML}{FCEDED}
\hypersetup{colorlinks=true,linkcolor=cnfVert,urlcolor=cnfVert,citecolor=cnfVert}

\newcommand{\cnfBande}[2]{%
  \begin{tikzpicture}
    \fill[cnfVertVif] (0,0) rectangle ({#1/3},#2);
    \fill[cnfJaune]   ({#1/3},0) rectangle ({2*#1/3},#2);
    \fill[cnfRouge]   ({2*#1/3},0) rectangle (#1,#2);
  \end{tikzpicture}}

% ---------------------------------------------------------------------
%  Informations du cours
% ---------------------------------------------------------------------
\newcommand{\cnfCours}{Introduction au Machine Learning}
\newcommand{\cnfNiveau}{Licence 3 \textperiodcentered{} Semestre 5 \textperiodcentered{} UE Informatique IV}

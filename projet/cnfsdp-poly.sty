\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cnfsdp-poly}[2026/10/12 Polycopie CNFSDP]

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[french]{babel}
\RequirePackage[a4paper,margin=2.3cm,top=2.6cm,bottom=2.4cm,headheight=14pt]{geometry}
